<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1113"
    android:keepScreenOn="true">

    <!-- OpenGL ES Canvas Surface for Custom Frame Rendering -->
    <android.opengl.GLSurfaceView
        android:id="@+id/gl_surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Real Video Surface View for normal standard video files -->
    <SurfaceView
        android:id="@+id/real_surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Transparent Touch Gesture Grabber Interface Overlay -->
    <View
        android:id="@+id/gesture_touch_grabber"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Dynamic Overlay: Double-Tap Flash Indicators --><!-- Center Gesture Overlay Banner (MX Player Style) -->
    <LinearLayout
        android:id="@+id/gesture_overlay_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="#66000000"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:gravity="center">

        <TextView
            android:id="@+id/gesture_action_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:text="⏩" />

        <TextView
            android:id="@+id/gesture_overlay_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="+01:25" />
    </LinearLayout>

    <!-- Interactive Bottom & Top HUD UI Controller Shell -->
    <RelativeLayout
        android:id="@+id/player_hud_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000"
        android:visibility="visible">

        <!-- Top Controls Layout Bar -->
        <RelativeLayout
            android:id="@+id/top_control_bar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentTop="true"
            android:background="#33000000"
            android:padding="8dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Return Back" />

            <TextView
                android:id="@+id/txt_file_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btn_back"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Custom_Native_H264_Stream.mkv" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_speed"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#1AFFFFFF"
                    android:textColor="#E2E2E6"
                    android:text="1.0x"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btn_audio_track"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#1AFFFFFF"
                    android:textColor="#E2E2E6"
                    android:text="ENG"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btn_aspect"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#1AFFFFFF"
                    android:textColor="#E2E2E6"
                    android:text="Fit" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Bottom Controller Panel -->
        <LinearLayout
            android:id="@+id/bottom_control_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#CC0F1113"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Scrubbing Timeline Slider -->
            <SeekBar
                android:id="@+id/player_seekbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1000"
                android:progress="0"
                android:progressTint="#3B82F6"
                android:thumbTint="#3B82F6" />

            <!-- Subtitle and Controls Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp">

                <!-- Current & Absolute Time Labels -->
                <TextView
                    android:id="@+id/txt_time_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:textColor="#EFEFEF"
                    android:textSize="12sp"
                    android:text="00:00" />

                <TextView
                    android:id="@+id/txt_duration_sep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/txt_time_current"
                    android:layout_centerVertical="true"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:text=" / " />

                <TextView
                    android:id="@+id/txt_time_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/txt_duration_sep"
                    android:layout_centerVertical="true"
                    android:textColor="#999999"
                    android:textSize="12sp"
                    android:text="03:00" />

                <!-- Play/Pause Button Toggle -->
                <ImageView
                    android:id="@+id/btn_play_pause"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_centerInParent="true"
                    android:src="@android:drawable/ic_media_play"
                    android:contentDescription="Play/Pause control" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <!-- Subtitle Switcher -->
                    <Button
                        android:id="@+id/btn_subtitles"
                        style="?android:attr/buttonStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="#1AFFFFFF"
                        android:textColor="#E2E2E6"
                        android:text="Subtitles" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <!-- Dynamic Embedded Subtitle View Container (smart rules mapping over context) -->
        <TextView
            android:id="@+id/txt_embedded_subtitles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/bottom_control_bar"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="24dp"
            android:background="#99000000"
            android:padding="8dp"
            android:textColor="#FFEB3B"
            android:textSize="16sp"
            android:visibility="gone"
            android:text="[Hello standard subtitle lines]" />
    </RelativeLayout>
</FrameLayout>
