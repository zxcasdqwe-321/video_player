<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1113"
    android:id="@+id/main_root">

    <!-- Top Glow / Modern Cyber header background effect -->
    <View
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_alignParentTop="true"
        android:background="#1B2B4A"
        android:alpha="0.15" />

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Custom Cyber Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Native CinePlayer"
                    android:textColor="#E2E2E6"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CORE DECODER • HI-RES PLAYBACK"
                    android:textColor="#3B82F6"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />
            </LinearLayout>

            <!-- Re-scan button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_rescan_card"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#1A1C1E"
                app:cardElevation="0dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/stat_notify_sync"
                    android:contentDescription="Rescan files"
                    android:padding="10dp"
                    android:tint="#3B82F6" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Rounded Custom Search bar -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#1A1C1E"
            app:cardElevation="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    android:tint="#888888"/>

                <EditText
                    android:id="@+id/search_bar_edit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:background="@null"
                    android:textColor="#FFFFFF"
                    android:hint="Search videos by title..."
                    android:textColorHint="#606060"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch"/>

                <ImageView
                    android:id="@+id/search_clear_btn"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="#888888"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Segmented Tab Switcher (Folders vs Favorites) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="#131517"
            android:padding="4dp"
            android:weightSum="2"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#05000000">

            <!-- Folders Tab Selection -->
            <TextView
                android:id="@+id/tab_folders"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Folders"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="#2563EB"
                android:clickable="true"
                android:focusable="true" />

            <!-- Favorites Tab Selection -->
            <TextView
                android:id="@+id/tab_favorites"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Favorites"
                android:textColor="#999999"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="@null"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Sorting Menu / Context Row -->
        <LinearLayout
            android:id="@+id/sort_selection_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sort:"
                android:textColor="#888888"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <!-- Sort Name chip -->
            <TextView
                android:id="@+id/sort_chip_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textColor="#3B82F6"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#1A3B82F6"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Sort Date chip -->
            <TextView
                android:id="@+id/sort_chip_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date"
                android:textColor="#888888"
                android:textSize="12sp"
                android:background="#1A1C1E"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Sort Size chip -->
            <TextView
                android:id="@+id/sort_chip_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Size"
                android:textColor="#888888"
                android:textSize="12sp"
                android:background="#1A1C1E"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Directory Path Title (e.g. "Folders > Movies" / visible only when showing videos inside a folder) -->
        <LinearLayout
            android:id="@+id/back_navigation_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btn_back_to_folders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀ Folders"
                android:textColor="#3B82F6"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="6dp"
                android:background="#1A3B82F6"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/txt_current_folder_path"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#B0B0B5"
                android:textStyle="bold"
                android:textSize="13sp"
                android:ellipsize="start"
                android:maxLines="1"
                android:text="Current Folder" />
        </LinearLayout>

        <!-- Custom empty state banner -->
        <LinearLayout
            android:id="@+id/empty_state_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@android:drawable/ic_menu_info_details"
                android:tint="#888888"/>

            <TextView
                android:id="@+id/empty_state_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No videos found."
                android:textColor="#888888"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <!-- Folder RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_folders"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />

        <!-- Videos RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_videos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:visibility="gone" />
    </LinearLayout>
</RelativeLayout>
